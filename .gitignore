# 运行时生成的本地鉴权 key（含个人 bearer key，绝不入库）
keys/*.key

# 运行日志 / pid / 抓包残留
logs/*
!logs/.gitkeep

# 自启脚本在运行时按本机绝对路径重新生成
scripts/start-silent.vbs

# 本机 opcode 配置备份（可能含个人 provider / 端点信息）
opencode.jsonc
opencode.jsonc.bak*
*.bak.workbuddy

# Node
node_modules/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.*
